# ─────────────────────────────────────────────────────────────────────────────
# styles/azure.d2 — the single source of visual truth for every diagram.
#
# D2 resolves imports relative to the importing FILE, so use the depth-relative
# path:  designs/<customer>/x.d2        -> ...@../../styles/azure.d2
#        designs/<customer>/phases/x.d2 -> ...@../../../styles/azure.d2
#        templates/x.d2                 -> ...@../styles/azure.d2
# Icon paths, by contrast, are resolved from the repository root (the render
# scripts run d2 from there), so icons are always ./icons/<slug>.svg
#
# Palette follows Microsoft's WAF diagramming guidance: containers stay
# restrained so the official icons carry the category colour, every layer is
# distinguished by BOTH colour and pattern (accessibility), and line semantics
# are consistent (solid = synchronous, dashed = private endpoint / async).
# Tune the hex values to match the customer's reference examples.
# ─────────────────────────────────────────────────────────────────────────────

vars: {
  d2-config: {
    layout-engine: elk          # orthogonal routing — the house style
    theme-id: 0                 # neutral; icons provide the colour
  }
}

classes: {
  # ── containment layers (outer → inner) ──────────────────────────────────────
  sub: {                         # Subscription
    style: { stroke: "#37475A"; stroke-width: 3; fill: "#F2F5F8"; border-radius: 6;  font-size: 15; bold: true }
  }
  rg: {                          # Resource Group — dashed (colour + pattern)
    style: { stroke: "#0078D4"; stroke-width: 2; stroke-dash: 5; fill: "#F8FBFE"; border-radius: 8; font-size: 13; bold: true }
  }
  vnet: {                        # Virtual Network
    style: { stroke: "#0E70C0"; stroke-width: 2; fill: "#E4F0FB"; border-radius: 10; font-size: 13; bold: true }
  }
  subnet: {                      # Subnet
    style: { stroke: "#90A2BC"; stroke-width: 1; fill: "#FAFBFD"; border-radius: 10; font-size: 12; bold: true }
  }

  # ── logical grouping (NOT an Azure hierarchy level) ──────────────────────────
  # For collecting things that belong together conceptually but not structurally
  # — "PaaS accessed via Private Endpoints", "Management and protection". Dotted
  # so it is never mistaken for a subscription, RG, VNet, or subnet boundary.
  group: { style: { stroke: "#8A8886"; stroke-width: 1; stroke-dash: 2; fill: "#FCFCFC"; border-radius: 4; font-size: 12 } }

  # ── leaf service (the node IS the official Azure icon) ───────────────────────
  svc: { shape: image; width: 74; height: 74 }

  # ── connection semantics ─────────────────────────────────────────────────────
  # Reverse-engineered from the Mitie and RADical reference diagrams so generated
  # output reads the same way as the hand-made set. Every class used in a diagram
  # must appear in that diagram's legend (contract rule R8).
  #
  #   ingress      blue solid       user / app inflow          users -> Front Door -> app
  #   sync         slate solid      internal service-to-service call
  #   devops       orange solid     DevOps and CI/CD            Pipelines -> ACR
  #   egress       red solid        crosses the internet boundary
  #   pe           blue dashed      private endpoint
  #   peering      slate dash-dot   VNet peering (a relationship, not a call)
  #   replication  green dashed     data replication            geo-replication, ASR
  #   mgmt         purple dashed    management / backup / diagnostics
  #
  ingress:     { style: { stroke: "#0078D4"; stroke-width: 2; font-size: 11 } }
  sync:        { style: { stroke: "#37475A"; stroke-width: 2; font-size: 11 } }
  devops:      { style: { stroke: "#D83B01"; stroke-width: 2; font-size: 11 } }
  egress:      { style: { stroke: "#C42B1C"; stroke-width: 2; font-size: 11 } }
  pe:          { style: { stroke: "#0078D4"; stroke-width: 2; stroke-dash: 3; font-size: 11 } }
  peering:     { style: { stroke: "#37475A"; stroke-width: 2; stroke-dash: 6; font-size: 11 } }
  replication: { style: { stroke: "#107C10"; stroke-width: 2; stroke-dash: 4; font-size: 11 } }
  mgmt:        { style: { stroke: "#8661C5"; stroke-width: 2; stroke-dash: 3; font-size: 11 } }

  # ── state ────────────────────────────────────────────────────────────────────
  # Deferred phases and DR standby, drawn greyed as in the reference set. Give it
  # a legend entry so grey is never ambiguous.
  future: { style: { stroke: "#A6A6A6"; stroke-width: 2; stroke-dash: 4; fill: "#F5F5F5"; font-color: "#767676" } }

  # ── diagram chrome (WAF: provide a legend, include metadata) ─────────────────
  legend:     { style: { fill: "#FFFFFF"; stroke: "#90A2BC"; stroke-width: 1; border-radius: 4; font-size: 11 } }
  # the anchor points a legend line is drawn between: present for the arrow to
  # attach to, but invisible, so the legend reads as a key rather than a diagram
  legendkey:  { width: 8; height: 8; style: { opacity: 0 } }
  # NOTE: do NOT build the title from a |md| block. D2 renders markdown as an
  # HTML <foreignObject>, which resvg cannot rasterise — the title survives in
  # the SVG but disappears from the PNG that goes into the Word document.
  # A plain text shape renders as real SVG text and survives both.
  titleblock: { shape: text; style: { font-size: 20; bold: true } }
}
