# rendered artefacts are regenerable from the .d2 sources
designs/**/*.svg
designs/**/*.png
designs/**/*.optimized.d2

# optimizer scratch
**/.opt_*
**/.winner.d2
**/*.__render.d2

# flat slug copies are generated by bin/build_manifest.py from the vendored set
icons/*.svg
icons/manifest.json

# locally-downloaded binaries (setup.ps1 puts resvg.exe here)
tools/

# python
__pycache__/
*.pyc

# os / editor
Thumbs.db
.DS_Store
.vscode/
